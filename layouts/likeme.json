{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "my-brand"
          },
          "size": {
            "px": 44
          },
          "window_drag": true
        },
        {
          "id": "sidebar-list",
          "type": "block",
          "content": {
            "mod": "my-sidebar"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "my-brand",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 76
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 222,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "my-tabs"
          },
          "size": {
            "px": 44
          },
          "window_drag": true
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "my-pane"
                },
                "reveal": "always",
                "height": 36,
                "position": "top"
              },
              "background": "surface",
              "radius": 0,
              "gap": 1,
              "lone": true
            }
          }
        }
      ],
      "floating": [
        {
          "id": "floating-files-mini",
          "content": {
            "mod": "my-float",
            "props": {
              "role": "mini"
            }
          },
          "edge": "bottom",
          "align": "end"
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "vscode-2026-light",
    "dark": "vscode-2026-dark"
  },
  "terminal_padding": [
    0,
    0
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}