{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "my-brand"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-list",
          "type": "block",
          "content": {
            "mod": "my-sidebar"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "my-brand",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 222,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "my-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "stack",
          "active": "main",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "my-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "surface",
                  "radius": 0,
                  "gap": 1,
                  "lone": true
                }
              }
            },
            {
              "id": "files",
              "type": "block",
              "content": {
                "mod": "my-files",
                "props": {
                  "workspace": true
                }
              }
            },
            {
              "id": "changes",
              "type": "block",
              "content": {
                "mod": "my-changes",
                "props": {
                  "workspace": true
                }
              }
            }
          ],
          "padding": 0
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    0,
    0
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
